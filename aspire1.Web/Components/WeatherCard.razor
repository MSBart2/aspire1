@using aspire1.Web.Services
@inject ReactionService ReactionSvc
@inject IReactionNotifier Notifier
@implements IDisposable

@if (Forecast != null)
{
    <div class="card weather-card @GetTemperatureClass(Forecast.TemperatureC) mb-3" role="article" data-testid="weather-card">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0" data-testid="weather-date">@Forecast.Date.ToString("dddd, MMMM d")</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="weather-temp">
                        <span class="display-4" data-testid="weather-temp-c" aria-label="Temperature in Celsius: @Forecast.TemperatureC degrees">@Forecast.TemperatureC°</span>
                        <span class="text-muted">C</span>
                    </div>
                    <div class="text-muted" data-testid="weather-temp-f">@Forecast.TemperatureF°F</div>
                </div>
                <div class="col-md-6">
                    <div class="weather-summary">
                        <h6 class="text-primary" data-testid="weather-summary">@Forecast.Summary</h6>
                        @if (ShowHumidity && Forecast.Humidity > 0)
                        {
                            <div class="humidity-info mt-2">
                                <i class="bi bi-droplet-fill text-info" aria-hidden="true"></i>
                                <strong>Humidity:</strong> @Forecast.Humidity%
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="reaction-bar mt-2 d-flex gap-2 flex-wrap" role="group" aria-label="Emoji reactions">
                @foreach (var emoji in ReactionService.SupportedEmojis)
                {
                    var e = emoji;
                    var count = _counts.GetValueOrDefault(e, 0);
                    <button class="btn btn-sm btn-outline-secondary @(ReactionSvc.HasVoted(Forecast.Date, e) ? "active" : "")"
                            @onclick="() => _ = ReactAsync(e)"
                            aria-label="@e, @count reactions"
                            data-testid="reaction-btn-@e"
                            type="button">
                        @e <span class="badge bg-secondary ms-1">@count</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public WeatherForecast? Forecast { get; set; }

    [Parameter]
    public bool ShowHumidity { get; set; }

    private Dictionary<string, int> _counts = [];
    private Func<DateOnly, IReadOnlyDictionary<string, int>, Task>? _handler;

    protected override async Task OnInitializedAsync()
    {
        if (Forecast != null)
            _counts = await ReactionSvc.GetReactionCountsAsync(Forecast.Date);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Forecast != null)
        {
            _handler = HandleReactionUpdateAsync;
            Notifier.Subscribe(_handler);
        }
        return Task.CompletedTask;
    }

    private async Task HandleReactionUpdateAsync(DateOnly date, IReadOnlyDictionary<string, int> counts)
    {
        if (Forecast == null || date != Forecast.Date) return;
        _counts = new Dictionary<string, int>(counts);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReactAsync(string emoji)
    {
        if (Forecast == null) return;
        await ReactionSvc.AddReactionAsync(Forecast.Date, emoji);
    }

    private string GetTemperatureClass(int temperatureC) =>
        temperatureC switch
        {
            < 0 => "weather-card--freezing",
            >= 0 and < 16 => "weather-card--chilly",
            >= 16 and < 26 => "weather-card--mild",
            >= 26 and <= 40 => "weather-card--hot",
            _ => "weather-card--scorching"
        };

    public void Dispose()
    {
        if (_handler != null)
            Notifier.Unsubscribe(_handler);
    }
}

